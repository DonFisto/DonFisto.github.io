---
import { timeline } from '../data/autonomousDriving';
interface Props { compact?: boolean; }
const {compact = false} = Astro.props;
---
<ol class:list={['development-timeline', compact && 'development-timeline--compact']}>
  {timeline.map(item => <li data-status={item.status}><div class="timeline-period">{item.period}</div><div><h3>{item.title}</h3>{!compact && <p>{item.description}</p>}</div><span class="status-label">{item.status}</span></li>)}
</ol>
